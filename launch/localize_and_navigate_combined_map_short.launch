<!-- localize_and_navigate_combined_map_short.launch -->
<launch>

  <param name="map_name" value="/navigation_map" />
  <param name="camera_inverted" type="bool" value="false" />

  <arg name="patrol" default="false" />
  <!-- Experimental: stop on the path to check ledger objects whose belief has decayed
       (needs the ledger + belief model: bringup ledger:=true). -->
  <arg name="observe" default="false"/>
  <arg name="observe_dwell_s" default="4.0"/>
  <arg name="observe_check_below_belief" default="0.5"/>
  <!-- Value objects by obstacle importance I_o (extra travel per trip if the object blocks), computed
       once per object on a topological roadmap of the static /map. -->
  <arg name="observe_importance" default="false"/>
  <arg name="observe_landmarks_file" default=""/>
  <!-- Detours: leave the path to re-check an object no on-path stop can see, when its value of
       information beats its cost (observation_planner decides, the navigator drives it). Objects
       needing more than observe_max_detour_m of extra driving are ignored. -->
  <arg name="observe_detour" default="false"/>
  <arg name="observe_max_detour_m" default="15.0"/>
  <arg name="observe_detour_n_trips" default="5"/>
  <arg name="observe_detour_margin_m" default="0.0"/>

  <param name="alpha1" value="0.075"/>
  <param name="alpha2" value="0.2"/>
  <param name="alpha3" value="0.1"/>
  <param name="alpha4" value="0.075"/>
  <param name="z_hit"  value="0.95"/>
  <param name="z_rand" value="0.05"/>
  <param name="sigma_hit" value="0.15"/>

    <!-- Nominal trajectory speed (m/s); override from bringup via launch arg when included. -->
  <arg name="cruising_velocity" default="0.40"/>
  <param name="cruising_velocity" value="$(arg cruising_velocity)"/>

  <param name="kpx" value="1.3"/>
  <param name="kpy" value="1.3"/>
  <param name="kdx" value="2.2"/>
  <param name="kdy" value="2.2"/>

  <arg name="social" default="false"/>
  <param name="use_social_astar" value="$(arg social)"/>

  <!-- Planning radius from robot center (m); navigator doubles for footprint collision checks. -->
  <arg name="robot_clearance" default="0.4"/>
  <!-- Max wall-clock time (s) for A* before giving up on a plan. -->
  <arg name="max_plan_time_sec" default="15.0"/>

  <!-- Launch the occupancy grid mapper -->
  <node name="occupancy_grid_node" pkg="mattbot_navigation" type="occupancy_grid_mapper.py" output="screen">

  </node>

  <node name="navigator_node" pkg="mattbot_navigation" type="localize_and_navigate.py" output="screen">
    <param name="observe_enabled" value="$(arg observe)"/>
    <param name="observe_detour_enabled" value="$(arg observe_detour)"/>
    <param name="observe_dwell_s" value="$(arg observe_dwell_s)"/>
    <param name="stall_detection_enabled" value="true"/>
    <param name="stall_cmd_vel_threshold" value="0.08"/>
    <param name="stall_odom_displacement_m" value="0.02"/>
    <param name="stall_window_sec" value="0.5"/>
    <param name="backing_duration_sec" value="1.0"/>
    <param name="relocalize_duration_sec" value="5.0"/>
    <param name="track_stall_grace_sec" value="1.0"/>
    <param name="nearest_free_search_radius" value="1.0"/>
    <param name="robot_clearance" value="$(arg robot_clearance)"/>
    <param name="max_plan_time_sec" value="$(arg max_plan_time_sec)"/>
  </node>

  <node if="$(arg observe)" name="observation_planner" pkg="mattbot_navigation" type="observation_planner.py" output="screen">
    <param name="dwell_s" value="$(arg observe_dwell_s)"/>
    <param name="check_below_belief" value="$(arg observe_check_below_belief)"/>
    <param name="importance_enabled" value="$(arg observe_importance)"/>
    <param name="robot_radius" value="$(arg robot_clearance)"/>
    <param name="landmarks_file" value="$(arg observe_landmarks_file)"/>
    <param name="detour_enabled" value="$(arg observe_detour)"/>
    <param name="max_detour_m" value="$(arg observe_max_detour_m)"/>
    <param name="detour_n_trips" value="$(arg observe_detour_n_trips)"/>
    <param name="detour_margin_m" value="$(arg observe_detour_margin_m)"/>
  </node>

  <!-- Launch the patrol.py script only if patrol is true -->
  <node name="patrol_node" pkg="mattbot_navigation" type="patrol.py" output="screen" if="$(arg patrol)">
  </node>


</launch>
